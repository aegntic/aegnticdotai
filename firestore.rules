rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to validate email format
    function isValidEmail(email) {
      return email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$');
    }

    // SUBSCRIBERS COLLECTION
    // ID-based security: We use the email address as the document ID.
    // This allows a client to check if *their* email exists (by trying to get it),
    // but prevents them from listing all subscribers.
    match /subscribers/{email} {
      // Allow reading a single document if the request ID matches the email (basic check)
      // or just allow get() generally so the "duplicate check" logic works.
      // Since the ID is the email, knowing the ID means you know the email.
      // We allow 'get' but NOT 'list'.
      allow get: if true;
      allow list: if false; 
      
      // Allow creation/update if data is valid
      allow write: if 
        // Ensure email matches ID
        request.resource.data.email == email &&
        // Validate email format
        isValidEmail(request.resource.data.email) &&
        // Basic spam prevention (optional, but good practice)
        request.resource.data.source is string &&
        request.resource.data.source.size() < 50;
    }

    // MESSAGES COLLECTION (Contact Form)
    match /messages/{messageId} {
      allow read: if false; // Admin only (via Console)
      allow create: if 
        // Basic validation
        request.resource.data.name.size() > 0 &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.message.size() > 0 &&
        isValidEmail(request.resource.data.email);
    }
  }
}
